# Зависимости
node_modules/

# Результат сборки
dist/

# Временные файлы фото-кэша
data/photos/**/.tmp-*

# Сгенерированные превью фотографий (источник — data/photos)
data/thumbnails/

# Сгенерированные зеркала фотографий и превью (источники — data/photos, data/thumbnails)
public/atlas/photos/
public/atlas/thumbnails/

# Сгенерированные бандлы, манифест и слои карты (источники — data/atlas, data/landmarks, aux, raw)
public/atlas/buildings.json
public/atlas/landmarks.json
public/atlas/manifest.json
public/atlas/basemap.geojson
public/atlas/building-outlines.geojson

# Отметка входных хешей для пересборки слоёв карты (scripts/build-map-layers.mjs)
.cache/

# Сгенерированный единый aux-файл (источник — aux/<city>)
data/aux/

# Служебные файлы TypeScript
*.tsbuildinfo

# Локальные настройки и секреты
.env
.env.*
*.env
*.env.*
!.env.example

# Логи
*.log

# Файлы редакторов и ОС
.vscode/
.idea/
.DS_Store
Thumbs.db

# Рабочие артефакты исследовательского конвейера
work/

# Python cache
__pycache__/
*.pyc
