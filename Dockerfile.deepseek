FROM node:24-bookworm-slim

ARG DSH_VERSION=0.2.1-rc.5

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl file git imagemagick jq procps \
      python3 python3-pil python3-pip python3-pyosmium python3-shapely python3-venv \
      unzip webp wget \
 && rm -rf /var/lib/apt/lists/* \
 && npm install --global "@deepseek-ai/dsh@${DSH_VERSION}" \
 && npm cache clean --force \
 && mkdir -p /dsh && chmod 1777 /dsh

# HOME и DSH_HOME лежат на томе, доступном только Harness-пользователю,
# а npm по умолчанию пишет кэш в недоступный $HOME/.npm.
ENV NPM_CONFIG_CACHE=/tmp/npm-cache \
    PIP_NO_CACHE_DIR=1

COPY scripts/run-deepseek-web.sh /usr/local/bin/atlas-deepseek-web
RUN chmod 0755 /usr/local/bin/atlas-deepseek-web

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/atlas-deepseek-web"]
