{
  "name": "tbilisi-architecture-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "assemble": "node scripts/assemble-atlas.mjs",
    "build": "node scripts/sync-photos.mjs && node scripts/assemble-atlas.mjs && node scripts/create-manifest.mjs && tsc -b && vite build",
    "check": "node scripts/sync-photos.mjs && node scripts/assemble-atlas.mjs && tsc --noEmit && node scripts/check-data.mjs",
    "photos:sync": "node scripts/sync-photos.mjs",
    "photos:migrate": "node scripts/migrate-photo-storage.mjs",
    "photos:thumbs": "python3 scripts/create-photo-thumbs.py",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify-dist.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.5"
  }
}
