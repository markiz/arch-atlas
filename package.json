{
  "name": "tbilisi-architecture-atlas",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "assemble": "node scripts/assemble-atlas.mjs",
    "landmarks:assemble": "node scripts/assemble-landmarks.mjs",
    "aux:merge": "node scripts/merge-aux.mjs",
    "layers:build": "node scripts/build-map-layers.mjs --all",
    "layers:force": "node scripts/build-map-layers.mjs --all --force",
    "outlines:build": "node scripts/build-outlines-binary.mjs --all",
    "outlines:force": "node scripts/build-outlines-binary.mjs --all --force",
    "build": "node scripts/build-all.mjs && tsc -b && vite build",
    "check": "node scripts/build-all.mjs --check && tsc --noEmit && node scripts/check-data.mjs --all",
    "photos:sync": "node scripts/create-photo-thumbs.mjs && node scripts/sync-photos.mjs",
    "photos:thumbs": "python3 scripts/create-photo-thumbs.py --all",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify-dist.mjs",
    "photos:rate": "python3 scripts/rate-photos.py --all",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,css}\" \"scripts/**/*.{js,mjs}\" \"tests/**/*.mjs\" \"vite.config.ts\" \"eslint.config.mjs\" \"tsconfig.json\" \"index.html\" \"package.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,css}\" \"scripts/**/*.{js,mjs}\" \"tests/**/*.mjs\" \"vite.config.ts\" \"eslint.config.mjs\" \"tsconfig.json\" \"index.html\" \"package.json\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/geojson": "^7946.0.16",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.5"
  }
}
